{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "src/**", "effect": "ask" },
    { "action": "edit", "resource": "tests/**", "effect": "allow" },
    { "action": "edit", "resource": "infra/**", "effect": "deny" },
    { "action": "edit", "resource": "migrations/**", "effect": "deny" },
    { "action": "edit", "resource": "functions/**", "effect": "ask" }
  ]
}
