# Resumora client env example — copy to .env.local (never commit secrets)
# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_BASIC=
VITE_STRIPE_PRICE_BALANCED=
VITE_STRIPE_PRICE_ELITE=
VITE_STRIPE_PRICE_ADVANCED=

# Stripe server / webhook (local dev + functions/.env)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PORT=3000
DATABASE_URL=
REDIS_URL=
RESEND_API_KEY=
SENDGRID_API_KEY=
DUNNING_FROM_EMAIL=billing@resumora.net
ALLOW_UNAUTH_BILLING=false

# Firebase (optional overrides; defaults to resumora-live web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# GA4 (optional; HTML gtag snippet is the live default)
VITE_GA_MEASUREMENT_ID=

# Organic social profile URLs (public; Vite inlines at build — no secrets)
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_BILIBILI=

# Test-mode paywall: set true to allow any signed-in user into Video Library
VITE_PAYWALL_ALLOW_AUTHED=

# App Check (reCAPTCHA Enterprise site key — public; set in GitHub Secrets for CI build)
VITE_FIREBASE_APP_CHECK_SITE_KEY=
APP_CHECK_RISK_THRESHOLD=0.5

# Bilibili publish (server-side only — set on Firebase Functions / Secret Manager)
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_DEDE_USER_ID=
BILIBILI_UPLOAD_PREFIX=bilibili-outbox/
BILIBILI_TAGS=Resumora,resume

# Checkout session ID prefix for Guardian / health (cs_live_ production, cs_test_ for Stripe test mode)
CHECKOUT_SESSION_PREFIX=cs_live_

# BossMind admin + documentation automation (Firebase Functions secrets — never commit values)
ADMIN_REFUND_PASSWORD=
GEMINI_API_KEY=

# Hermes Agent (OpenAI-compatible gateway — Cloud Functions call HERMES_API_URL; never commit keys)
# Local Windows home: %LOCALAPPDATA%\hermes (.env + config.yaml). See docs/HERMES_INTEGRATION.md
HERMES_API_URL=
HERMES_API_SERVER_KEY=
API_SERVER_KEY=
HERMES_CHAT_ENABLED=true
HERMES_MODEL_NAME=hermes-agent
HERMES_CHAT_TIMEOUT_MS=30000
HERMES_MAX_INFLIGHT=6
HERMES_STREAM=true
GEMINI_CHAT_MODEL=gemini-2.0-flash
ALPHA_VANTAGE_KEY=

# Harness task GitHub webhook (HMAC) — never commit the value
# GITHUB_WEBHOOK_SECRET=

# ElegancyArt Checkout (optional — same or separate Stripe account)
# ELEGANCYART_STRIPE_SECRET_KEY=
# ELEGANCYART_STRIPE_PRICE_BASIC=
# ELEGANCYART_STRIPE_PRICE_STANDARD=
# ELEGANCYART_CHECKOUT_SUCCESS_URL=
# ELEGANCYART_CHECKOUT_CANCEL_URL=
