# Resumora client env example — copy to .env.local (never commit secrets)
# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_BASIC=
VITE_STRIPE_PRICE_BALANCED=
VITE_STRIPE_PRICE_PRO=
VITE_STRIPE_PRICE_PROFESSIONAL_TIER=
VITE_STRIPE_PRICE_ELITE=
VITE_STRIPE_PRICE_ADVANCED=
# Optional Payment Link fallbacks (used if Checkout session API fails)
VITE_STRIPE_PAYMENT_LINK_BASIC=
VITE_STRIPE_PAYMENT_LINK_BALANCED=
VITE_STRIPE_PAYMENT_LINK_PROFESSIONAL_TIER=
VITE_STRIPE_PAYMENT_LINK_ELITE=
VITE_STRIPE_PAYMENT_LINK_ADVANCED=

# Firebase (optional overrides; defaults to resumora-live web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Test-mode paywall: set true to allow any signed-in user into Video Library
VITE_PAYWALL_ALLOW_AUTHED=

# Google Analytics 4 (public G- measurement ID — safe for client bundles)
VITE_GA_MEASUREMENT_ID=
# Alias / Firebase Analytics measurement ID also accepted by analytics.js
# VITE_FIREBASE_MEASUREMENT_ID=

# Social profile URLs (https only — used by SiteFooter; leave blank to hide icons)
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_TIKTOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_BILIBILI_URL=

# Self-heal / KYC alerts (Cloud Functions / Secret Manager — never commit values)
# RESEND_API_KEY= or EMAIL_API_KEY=
# SELF_HEAL_ADMIN_EMAIL=info@resumora.net
# SLACK_WEBHOOK_URL=
# SELF_HEAL_SLACK_WEBHOOK=
# SELF_HEAL_ALERT_THRESHOLD=70
# STRIPE_KYC_ALERT_EMAIL=info@resumora.net

# HeyGen (server-side only — set on Firebase Functions / functions/.env)
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
