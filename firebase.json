{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "client-resumora-live",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/resumora-logo.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/create-checkout-session",
        "function": "createCheckoutSession"
      },
      {
        "source": "/api/webhook",
        "function": "stripeWebhook"
      },
      {
        "source": "/api/refund-preview",
        "function": "getRefundPreview"
      },
      {
        "source": "/api/cancel-subscription",
        "function": "cancelSubscription"
      },
      {
        "source": "/api/service-event",
        "function": "recordServiceEventHttp"
      },
      {
        "source": "/api/refunds",
        "function": "listRefundsHttp"
      },
      {
        "source": "/api/refund-preview-v2",
        "function": "getRefundPreviewV2"
      },
      {
        "source": "/api/analytics/revenue",
        "function": "getRevenueAnalytics"
      },
      {
        "source": "/api/analytics/churn",
        "function": "getChurnPrediction"
      },
      {
        "source": "/api/video/catalog",
        "function": "videoCatalog"
      },
      {
        "source": "/api/video/download",
        "function": "videoDownload"
      },
      {
        "source": "/api/chat/message",
        "run": {
          "serviceId": "sendchatmessage",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/chat/send",
        "run": {
          "serviceId": "sendchatmessage",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/system-health",
        "function": "getSystemHealth"
      },
      {
        "source": "/api/admin/system-health/run",
        "function": "runSystemHealth"
      },
      {
        "source": "/api/admin/system-health/decide",
        "function": "decideSystemHeal"
      },
      {
        "source": "/api/admin/system-manual/update",
        "function": "updateSystemManual"
      },
      {
        "source": "/api/admin/master-dashboard",
        "function": "getMasterDashboard"
      },
      {
        "source": "/api/admin/master-projects",
        "function": "getMasterProjects"
      },
      {
        "source": "/api/admin/hermes-command",
        "function": "postAdminHermesCommand"
      },
      {
        "source": "/api/admin/password-reset/request",
        "function": "requestAdminPasswordReset"
      },
      {
        "source": "/api/admin/password-reset/confirm",
        "function": "confirmAdminPasswordReset"
      },
      {
        "source": "/api/admin/hermes-status",
        "function": "getHermesStatus"
      },
      {
        "source": "/api/admin/hermes-chat",
        "function": "setHermesChat"
      },
      {
        "source": "/api/admin/hermes-insights",
        "function": "getHermesInsights"
      },
      {
        "source": "/api/admin/tasks",
        "function": "listHarnessTasks"
      },
      {
        "source": "/api/admin/tasks/create",
        "function": "createHarnessTask"
      },
      {
        "source": "/api/admin/tasks/ack",
        "function": "ackHarnessTask"
      },
      {
        "source": "/api/admin/tasks/mark-applied",
        "function": "markHarnessTaskApplied"
      },
      {
        "source": "/api/admin/tasks/automation",
        "function": "setHarnessAutomation"
      },
      {
        "source": "/api/webhooks/github",
        "function": "githubDeployWebhook"
      },
      {
        "source": "/api/admin/financials",
        "function": "getAdminFinancials"
      },
      {
        "source": "/api/admin/financials/allocate",
        "function": "runFinanceAllocation"
      },
      {
        "source": "/admin/system-health",
        "destination": "/admin.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/bossmind",
        "destination": "/admin.html"
      },
      {
        "source": "/bossmind/**",
        "destination": "/admin.html"
      },
      {
        "source": "/pricing",
        "destination": "/pricing.html"
      },
      {
        "source": "/pricing/**",
        "destination": "/pricing.html"
      },
      {
        "source": "/plans",
        "destination": "/pricing.html"
      },
      {
        "source": "/studio",
        "destination": "/studio.html"
      },
      {
        "source": "/studio/**",
        "destination": "/studio.html"
      },
      {
        "source": "/resume-studio",
        "destination": "/studio.html"
      },
      {
        "source": "/videos",
        "destination": "/videos.html"
      },
      {
        "source": "/videos/**",
        "destination": "/videos.html"
      },
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/account",
        "destination": "/index.html"
      },
      {
        "source": "/account/**",
        "destination": "/index.html"
      },
      {
        "source": "/video-library",
        "destination": "/index.html"
      },
      {
        "source": "/video-library/**",
        "destination": "/index.html"
      },
      {
        "source": "/reset-password",
        "destination": "/reset-password.html"
      },
      {
        "source": "/forgot-password",
        "destination": "/reset-password.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "resumora-checkout",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ]
}
