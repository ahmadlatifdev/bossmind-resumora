# Hermes Idea Request Queue — never commit real values
REDIS_URL=redis://redis:6379
REPO_ROOT=/workspace
BACKLOG_PATH=/workspace/hermes-idea-queue/data/sample-backlog.json

# LLM triage (OpenAI-compatible; DeepSeek / Google AI / etc.)
HERMES_LLM_BASE_URL=https://api.deepseek.com/v1
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=deepseek-chat

# Cursor agent (optional — dry-run without key)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_DRY_RUN=true

# Vector / RAG
PINECONE_API_KEY=
PINECONE_INDEX=resumora-idea-queue
PINECONE_HOST=
EMBEDDING_DIM=384
RAG_TOP_K=8
RAG_MAX_CHARS=12000

# Orchestration
MAX_NIGHTLY_PRS=25
MAX_CONCURRENT_TASKS=2
MAX_QA_RETRIES=3
FILE_LOCK_TTL_SEC=1800
BRANCH_PREFIX=feat/auto-issue-

# HITL dashboard
HITL_PORT=8790
HITL_TOKEN=change-me-local-only

# GitHub (PR push / self-heal)
GITHUB_TOKEN=
GITHUB_REPO=ahmadlatifdev/bossmind-resumora
GIT_AUTHOR_NAME=Hermes Idea Queue
GIT_AUTHOR_EMAIL=hermes-idea-queue@users.noreply.github.com

# Safety: never auto-merge to these branches
PROTECTED_BASE_BRANCHES=main,master,production
