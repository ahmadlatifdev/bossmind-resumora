# Serverless avatar video pipeline configuration
# Copy values into a .env in the repo root (or export them).

# HeyGen API key (https://app.heygen.com → API → API Key)
HEYGEN_API_KEY=

# HeyGen avatar id (create a talking-photo/avatar in HeyGen, then copy its id)
HEYGEN_AVATAR_ID=

# Firebase / Google service-account JSON (for Storage upload + signed URLs)
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Storage bucket (default: resumora-videos)
STORAGE_BUCKET=resumora-videos
