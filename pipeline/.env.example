# Serverless Video API configuration
# Copy this file to pipeline/.env and fill in your values.

# JSON2Video API key (https://json2video.com → Dashboard → API Key)
JSON2VIDEO_API_KEY=

# Public base URL where the audio MP3s are hosted (Firebase Storage / GCS).
# Upload pipeline/assets/audio/*.mp3 to a bucket and paste its public prefix, e.g.:
#   AUDIO_BASE_URL=https://storage.googleapis.com/<bucket>/audio
AUDIO_BASE_URL=
