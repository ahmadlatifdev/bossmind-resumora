# Paste Live Price IDs + publishable key into .env.local ONLY (never into Cursor chat).
# Then run from repo root:
#   powershell -ExecutionPolicy Bypass -File scripts\apply-live-stripe-prices.ps1
#
# Required keys in .env.local (Vite project uses VITE_ + NEXT_PUBLIC_ aliases):
#
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# VITE_STRIPE_PRICE_BASIC=price_...          # UI Basic $29  → planId basic
# NEXT_PUBLIC_STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_BASIC=price_...
# VITE_STRIPE_PRICE_BALANCED=price_...       # UI Pro $49     → planId balanced
# STRIPE_PRICE_BALANCED=price_...
# VITE_STRIPE_PRICE_ELITE=price_...          # UI Business $79 → planId professional
# NEXT_PUBLIC_STRIPE_PRICE_ELITE=price_...
# STRIPE_PRICE_PROFESSIONAL_TIER=price_...
# VITE_STRIPE_PRICE_ADVANCED=price_...       # UI Enterprise $110 → planId advanced
# NEXT_PUBLIC_STRIPE_PRICE_ESSENTIAL_ADVANCED=price_...
# STRIPE_PRICE_ADVANCED=price_...
#
# Do NOT put sk_live_ / whsec_ in this chat. Keep them only in .env.local / Secret Manager.
