rules_version = '2';

/**
 * Resumora Firestore — Defense in Depth (Level 2).
 * Default deny; explicit owner/participant access only.
 * Server-side collections (system_*, videos, user_downloads, etc.) are Admin SDK only.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatParticipant() {
      return isSignedIn()
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;
    }

    function isChatParticipantOnCreate() {
      return isSignedIn()
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds;
    }

    // users — read/write own profile only
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    // chats — participants only (support / coaching threads)
    match /chats/{chatId} {
      allow read: if isChatParticipant();
      allow create: if isChatParticipantOnCreate();
      allow update, delete: if isChatParticipant();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

  // Harness — admin chat sessions (authenticated users only)
  match /harness_sessions/{sessionId} {
    allow read, write: if isSignedIn();
  }

  // Harness — audit log (write via Cloud Functions only)
  match /harness_audit_log/{logId} {
    allow read: if isSignedIn();
    allow write: if false;
  }

  // Harness — support tickets (public create, authenticated read)
  match /support_tickets/{ticketId} {
    allow create: if true;
    allow read, update: if isSignedIn();
    allow delete: if false;
  }

  // Harness — rate limits (write via Cloud Functions only)
  match /harness_rate_limits/{sessionId} {
    allow read, write: if false;
  }

    // Deny all other client access (Admin SDK / Cloud Functions bypass rules)
    // Includes: system_*, videos, projects (BossMind harness registry), admin_settings, etc.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
