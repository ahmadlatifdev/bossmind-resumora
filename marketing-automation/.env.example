# Resumora social posting credentials (copy to a gitignored `.env` at the repo root).
# NEVER commit real values. Each platform requires its own developer-app setup.

# --- LinkedIn (OAuth 2.0) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# --- Twitter / X (OAuth 1.0a) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Facebook (Graph API, Page) ---
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
